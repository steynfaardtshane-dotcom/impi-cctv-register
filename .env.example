# Copy this file to ".env" and fill in your own values.
# Get these from your Supabase project: Settings > API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# The email address that should get admin rights (delete sites).
# This must exactly match the account you log in with, and the email
# hardcoded in supabase/schema.sql's is_impi_admin() function.
VITE_ADMIN_EMAIL=shane@impi-secure.co.za
